## Cell 5: Complete Data Availability & Year-Presence Cohort Report (`Oct 2022 – Dec 2025`)

```python
# %% [markdown]
# ## 4. Data Availability & Year-Cohort Report (`Part Name + Region Id`)
# Evaluates every `Part Name + Region Id` series across **Oct 2022 – Dec 2025 (39 months)** to report:
# - **All Year-Presence Combinations/Iterations** (e.g., `2022, 2023, 2024, 2025`, `2023, 2024, 2025`, `2023 only`, `2024 only`, `2025 only`, discontinuous gap patterns like `2023, 2025`, etc.)
# - **Active Months Available** (overall and per calendar year: `2022`, `2023`, `2024`, `2025`)
# - **Recency & Continuity Metrics** (`First_Month`, `Last_Month`, `Span_Months`, `Months_Since_Dec2025`, `ADI`, `CV`)
# - **Actionable Forecastability Triage**

# %%
MAX_PERIOD = pd.Period("2025-12", freq="M")
MIN_PERIOD = pd.Period("2022-10", freq="M")

# Monthly counts per year for each Part Name + Region Id
yr_pivot = (
    monthly_df.pivot_table(
        index=["Part Name", "Region Id", "Part_Region_Key"],
        columns="Year",
        values="Monthly_Qty",
        aggfunc="count",
        fill_value=0,
    )
    .reset_index()
)
for yr in [2022, 2023, 2024, 2025]:
    if yr not in yr_pivot.columns:
        yr_pivot[yr] = 0
yr_pivot = yr_pivot.rename(columns={2022: "Mos_2022", 2023: "Mos_2023", 2024: "Mos_2024", 2025: "Mos_2025"})

# Series-level history & demand behavior metrics
series_profile = (
    monthly_df.groupby(["Part Name", "Region Id", "Part_Region_Key"], as_index=False)
    .agg(
        Active_Months=("YearMonth", "nunique"),
        First_Month=("YearMonth", "min"),
        Last_Month=("YearMonth", "max"),
        Total_Quantity=("Monthly_Qty", "sum"),
        Total_Orders=("Order_Count", "sum"),
        Mean_Active_Monthly_Qty=("Monthly_Qty", "mean"),
        Std_Active_Monthly_Qty=("Monthly_Qty", "std"),
        Primary_Segment=("Primary_Segment", "first"),
        Primary_Site=("Primary_Site", "first"),
        Primary_Bulk=("Primary_Bulk", "first"),
    )
)

series_profile = series_profile.merge(
    yr_pivot[["Part Name", "Region Id", "Mos_2022", "Mos_2023", "Mos_2024", "Mos_2025"]],
    on=["Part Name", "Region Id"],
    how="left",
)

# Build exact Year-Presence Combination string (all possible iterations)
def build_year_combo(row):
    active_yrs = [str(y) for y, col in [(2022, "Mos_2022"), (2023, "Mos_2023"), (2024, "Mos_2024"), (2025, "Mos_2025")] if row[col] > 0]
    if len(active_yrs) == 1:
        return f"{active_yrs[0]} Only"
    return " - ".join(active_yrs)

series_profile["Year_Iteration"] = series_profile.apply(build_year_combo, axis=1)
series_profile["Num_Active_Years"] = (
    (series_profile["Mos_2022"] > 0).astype(int)
    + (series_profile["Mos_2023"] > 0).astype(int)
    + (series_profile["Mos_2024"] > 0).astype(int)
    + (series_profile["Mos_2025"] > 0).astype(int)
)

# Span & Recency calculations (using ordinal integer difference on Period('M'))
series_profile["Span_Months"] = (series_profile["Last_Month"].astype("int64") - series_profile["First_Month"].astype("int64")) + 1
series_profile["Months_Since_Last_Order"] = MAX_PERIOD.ordinal - series_profile["Last_Month"].astype("int64")
series_profile["Fill_Rate_Within_Span_%"] = (series_profile["Active_Months"] / series_profile["Span_Months"] * 100).round(1)

# Syntetos-Boylan Demand Classification metrics (ADI & CV^2)
series_profile["ADI"] = (series_profile["Span_Months"] / series_profile["Active_Months"]).round(2)
series_profile["CV"] = (
    series_profile["Std_Active_Monthly_Qty"].fillna(0) / series_profile["Mean_Active_Monthly_Qty"]
).round(2)
series_profile["CV2"] = (series_profile["CV"] ** 2).round(2)

# ------------------------------------------------------------------------------
# A. Complete Report Across ALL Year-Presence Iterations
# ------------------------------------------------------------------------------
total_series = len(series_profile)
total_vol = series_profile["Total_Quantity"].sum()

year_cohort_report = (
    series_profile.groupby("Year_Iteration", as_index=False)
    .agg(
        Part_Region_Count=("Part_Region_Key", "count"),
        Unique_Parts=("Part Name", "nunique"),
        Total_Quantity=("Total_Quantity", "sum"),
        Avg_Active_Months=("Active_Months", "mean"),
        Median_Active_Months=("Active_Months", "median"),
        Min_Active_Months=("Active_Months", "min"),
        Max_Active_Months=("Active_Months", "max"),
        Active_In_Q4_2025=("Months_Since_Last_Order", lambda s: (s <= 2).sum()),
    )
    .sort_values("Part_Region_Count", ascending=False)
)

year_cohort_report["Series_Share_%"] = (year_cohort_report["Part_Region_Count"] / total_series * 100).round(2)
year_cohort_report["Volume_Share_%"] = (year_cohort_report["Total_Quantity"] / total_vol * 100).round(2)
year_cohort_report["Avg_Active_Months"] = year_cohort_report["Avg_Active_Months"].round(1)

# Reorder columns cleanly
year_cohort_report = year_cohort_report[[
    "Year_Iteration",
    "Part_Region_Count",
    "Series_Share_%",
    "Unique_Parts",
    "Total_Quantity",
    "Volume_Share_%",
    "Avg_Active_Months",
    "Median_Active_Months",
    "Min_Active_Months",
    "Max_Active_Months",
    "Active_In_Q4_2025",
]]

display(Markdown("### A. All Year-Presence Iterations Report (`Part Name + Region Id` Level)"))
display(year_cohort_report)

# ------------------------------------------------------------------------------
# B. Distribution of Available Active Months (Bucketed & Exact)
# ------------------------------------------------------------------------------
bins = [0, 1, 3, 6, 12, 18, 24, 30, 36, 39]
labels = [
    "01 mo (Single-month spike)",
    "02–03 mos",
    "04–06 mos",
    "07–12 mos",
    "13–18 mos",
    "19–24 mos",
    "25–30 mos",
    "31–36 mos",
    "37–39 mos (Full 3+ yr span)",
]
series_profile["Months_Bucket"] = pd.cut(series_profile["Active_Months"], bins=bins, labels=labels)

months_bucket_report = (
    series_profile.groupby("Months_Bucket", observed=False, as_index=False)
    .agg(
        Part_Region_Count=("Part_Region_Key", "count"),
        Total_Quantity=("Total_Quantity", "sum"),
        Active_In_2025=("Mos_2025", lambda s: (s > 0).sum()),
        Active_In_Q4_2025=("Months_Since_Last_Order", lambda s: (s <= 2).sum()),
    )
)
months_bucket_report["Series_Share_%"] = (months_bucket_report["Part_Region_Count"] / total_series * 100).round(2)
months_bucket_report["Volume_Share_%"] = (months_bucket_report["Total_Quantity"] / total_vol * 100).round(2)

display(Markdown("### B. Active Months Availability Distribution"))
display(months_bucket_report)

# ------------------------------------------------------------------------------
# C. Forecastability Triage Classification
# ------------------------------------------------------------------------------
def classify_forecastability(row):
    if row["Mos_2025"] == 0 or row["Months_Since_Last_Order"] > 6:
        return "4. Dormant / Discontinued (No orders in H2 2025)"
    if row["Year_Iteration"] == "2025 Only":
        return "3. Cold-Start / 2025 New SKU Only (Needs Analog/Global Pooling)"
    if row["Active_Months"] >= 18 and row["Num_Active_Years"] >= 3:
        return "1. Tier-1 Forecastable (Multi-Year >=18 Active Mos & Recent)"
    if row["Active_Months"] >= 10 and row["Num_Active_Years"] >= 2:
        return "2. Tier-2 Forecastable (2+ Years, 10-17 Active Mos & Recent)"
    return "5. Ultra-Sparse / Intermittent (<10 Active Mos Across Multi-Year)"

series_profile["Forecastability_Tier"] = series_profile.apply(classify_forecastability, axis=1)

triage_report = (
    series_profile.groupby("Forecastability_Tier", as_index=False)
    .agg(
        Part_Region_Count=("Part_Region_Key", "count"),
        Unique_Parts=("Part Name", "nunique"),
        Total_Quantity=("Total_Quantity", "sum"),
        Avg_Active_Months=("Active_Months", "mean"),
    )
    .sort_values("Forecastability_Tier")
)
triage_report["Series_Share_%"] = (triage_report["Part_Region_Count"] / total_series * 100).round(2)
triage_report["Volume_Share_%"] = (triage_report["Total_Quantity"] / total_vol * 100).round(2)
triage_report["Avg_Active_Months"] = triage_report["Avg_Active_Months"].round(1)

display(Markdown("### C. Forecasting Readiness Triage Summary"))
display(triage_report)

