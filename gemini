## Cell 2: Data Ingestion & Schema Normalization

```python
# %% [markdown]
# ## 1. Data Ingestion & Raw Schema Audit
# Enforces string types on all categorical/ID fields, normalizes whitespace-only blanks to `NaN`, and safely parses comma-formatted quantities and `DD-MMM-YY` dates.

# %%
STRING_COLS = [
    "Part Name",
    "Part Site",
    "Bulk Value",
    "Business Segment Value",
    "Business Segment Description",
    "Region Id",
]

def load_raw_dataset(path: Path, sheet_name: str = "HDA") -> pd.DataFrame:
    dtype_map = {col: "string" for col in STRING_COLS}
    dtype_map["Quantity"] = "string"  # Parse manually to handle commas safely

    if path.suffix.lower() in [".xlsx", ".xls"]:
        df = pd.read_excel(path, sheet_name=sheet_name, dtype=dtype_map)
    else:
        df = pd.read_csv(path, dtype=dtype_map, low_memory=False)

    # Standardize column headers (strip accidental leading/trailing spaces)
    df.columns = [c.strip() for c in df.columns]

    # Clean string columns: strip whitespace and convert empty/placeholder strings to pd.NA
    blank_tokens = {"", "nan", "none", "null", "na", "n/a", "-"}
    for col in STRING_COLS:
        if col in df.columns:
            cleaned = df[col].astype("string").str.strip()
            cleaned = cleaned.mask(cleaned.str.lower().isin(blank_tokens), pd.NA)
            df[col] = cleaned

    # Clean Quantity: strip commas/spaces and convert to float64
    qty_clean = (
        df["Quantity"]
        .astype("string")
        .str.replace(",", "", regex=False)
        .str.strip()
    )
    df["Quantity"] = pd.to_numeric(qty_clean, errors="coerce")

    # Parse Date (handles formats like '25-Nov-22', '2022-11-25', etc.)
    df["Date"] = pd.to_datetime(df["Date"], format="mixed", dayfirst=True, errors="coerce")

    return df

raw_df = load_raw_dataset(FILE_PATH, SHEET_NAME)
raw_df["Part_Region_Key"] = raw_df["Part Name"].fillna("MISSING") + " | " + raw_df["Region Id"].fillna("MISSING")

print(f"Raw Dataset Shape       : {raw_df.shape[0]:,} rows x {raw_df.shape[1]-1} columns")
print(f"Raw Date Range          : {raw_df['Date'].min().strftime('%Y-%m-%d')} to {raw_df['Date'].max().strftime('%Y-%m-%d')}")
print(f"Unparseable Dates       : {raw_df['Date'].isna().sum():,}")
print(f"Unparseable Quantities  : {raw_df['Quantity'].isna().sum():,}")
print(f"Raw Net Quantity Sum    : {raw_df['Quantity'].sum():,.2f}")
print(f"Raw Positive Qty Sum    : {raw_df.loc[raw_df['Quantity'] > 0, 'Quantity'].sum():,.2f}")

# Raw column-level profile
schema_audit = pd.DataFrame({
    "Dtype": raw_df.drop(columns=["Part_Region_Key"]).dtypes.astype(str),
    "Non_Null_Rows": raw_df.drop(columns=["Part_Region_Key"]).notna().sum(),
