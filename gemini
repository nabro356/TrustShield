# Parts first seen in 2025 (no earlier history) that appear only once
def one_time_2025(df, keys):
    g = df.groupby(keys).agg(
        First_Date=("Date", "min"),
        Transactions=("Quantity", "count"),
        Active_Months=("YearMonth", "nunique"),
        Total_Qty=("Quantity", "sum"),
    ).reset_index()
    new_2025 = g[g["First_Date"] >= "2025-01-01"]          # no history before 2025
    return new_2025, new_2025[new_2025["Active_Months"] == 1], new_2025[new_2025["Transactions"] == 1]

