    "Blank_%": (raw_df.drop(columns=["Part_Region_Key"]).isna().mean() * 100).round(2),
    "Unique_Values": raw_df.drop(columns=["Part_Region_Key"]).nunique(dropna=True),
})
display(Markdown("### Raw Schema & Missingness Summary"))
display(schema_audit)

