## Cell 3: Detailed Data Cleaning & Attrition Waterfall Analysis

```python
# %% [markdown]
# ## 2. Data Cleaning & Detailed Attrition Analysis
# Applies the four exclusion rules:
# 1. `Quantity <= 0.0` (or null)
# 2. `Business Segment Description` is blank
# 3. `Part Name` starts with `'9'`
# 4. `Bulk Value` is blank
#
# Reports both **Independent Rule Flags** (to expose rule overlaps) and the **Sequential Waterfall** (exact step-by-step attrition).

# %%
# Define boolean exclusion masks on raw_df
mask_qty = raw_df["Quantity"].isna() | (raw_df["Quantity"] <= 0.0)
mask_seg = raw_df["Business Segment Description"].isna()
mask_part9 = raw_df["Part Name"].fillna("").str.startswith("9")
mask_bulk = raw_df["Bulk Value"].isna()

# Also flag if Part Name or Region Id itself is missing (safety check for forecasting key)
mask_key_missing = raw_df["Part Name"].isna() | raw_df["Region Id"].isna()

# ------------------------------------------------------------------------------
# A. Independent Rule Impact (Evaluated independently on the full raw dataset)
# ------------------------------------------------------------------------------
rules_dict = {
    "Rule 1: Quantity <= 0.0 (or NaN)": mask_qty,
    "Rule 2: Business Segment Description Blank": mask_seg,
    "Rule 3: Part Name Starts with '9'": mask_part9,
    "Rule 4: Bulk Value Blank": mask_bulk,
    "Safety Check: Part Name or Region Id Blank": mask_key_missing,
}

indep_rows = []
total_raw_rows = len(raw_df)
total_raw_pos_qty = raw_df.loc[raw_df["Quantity"] > 0, "Quantity"].sum()

for rule_name, m in rules_dict.items():
    flagged = raw_df[m]
    pos_qty_flagged = flagged.loc[flagged["Quantity"] > 0, "Quantity"].sum()
    neg_qty_flagged = flagged.loc[flagged["Quantity"] < 0, "Quantity"].sum()
    zero_rows = (flagged["Quantity"] == 0).sum()
    neg_rows = (flagged["Quantity"] < 0).sum()
    indep_rows.append({
        "Cleaning_Rule": rule_name,
        "Flagged_Rows": len(flagged),
        "Flagged_Rows_%": round(len(flagged) / total_raw_rows * 100, 2),
        "Zero_Qty_Rows": zero_rows,
        "Negative_Qty_Rows": neg_rows,
        "Positive_Qty_Affected": pos_qty_flagged,
        "Positive_Qty_%": round(pos_qty_flagged / total_raw_pos_qty * 100, 2),
        "Negative_Qty_Affected": neg_qty_flagged,
        "Unique_Parts_Affected": flagged["Part Name"].nunique(dropna=True),
        "Unique_Part_Regions_Affected": flagged["Part_Region_Key"].nunique(),
    })

indep_df = pd.DataFrame(indep_rows)
display(Markdown("### A. Independent Rule Impact (Before Considering Rule Overlaps)"))
display(indep_df)

# ------------------------------------------------------------------------------
# B. Sequential Waterfall Analysis
# ------------------------------------------------------------------------------
waterfall_steps = [
    ("0. Raw Dataset (Initial)", pd.Series(False, index=raw_df.index)),
    ("1. Remove Quantity <= 0.0", mask_qty),
    ("2. Remove Blank Business Segment Description", mask_seg),
    ("3. Remove Part Name Starting with '9'", mask_part9),
    ("4. Remove Blank Bulk Value", mask_bulk),
    ("5. Remove Missing Part Name / Region Id / Date", mask_key_missing | raw_df["Date"].isna()),
]

curr_df = raw_df.copy()
waterfall_records = []

for step_name, step_mask in waterfall_steps:
    if step_name.startswith("0."):
        removed_rows = 0
        removed_pos_qty = 0.0
    else:
        aligned_mask = step_mask.loc[curr_df.index]
        dropped_slice = curr_df[aligned_mask]
        removed_rows = len(dropped_slice)
        removed_pos_qty = dropped_slice.loc[dropped_slice["Quantity"] > 0, "Quantity"].sum()
        curr_df = curr_df[~aligned_mask].copy()

    waterfall_records.append({
        "Step": step_name,
        "Rows_Removed": removed_rows,
        "Rows_Remaining": len(curr_df),
        "Retained_Rows_%": round(len(curr_df) / total_raw_rows * 100, 2),
        "Pos_Qty_Removed": removed_pos_qty,
        "Qty_Remaining": curr_df["Quantity"].sum(),
        "Retained_Qty_%": round(curr_df["Quantity"].sum() / total_raw_pos_qty * 100, 2),
        "Unique_Parts": curr_df["Part Name"].nunique(),
        "Unique_Regions": curr_df["Region Id"].nunique(),
        "Unique_Part_Region_Pairs": curr_df["Part_Region_Key"].nunique(),
    })

waterfall_df = pd.DataFrame(waterfall_records)
display(Markdown("### B. Sequential Cleaning Waterfall"))
display(waterfall_df)

# Diagnostic breakdown of removed records by Region Id
diag_by_region = pd.DataFrame({
    "Raw_Rows": raw_df.groupby("Region Id", dropna=False).size(),
    "Removed_Qty_<=0": raw_df[mask_qty].groupby("Region Id", dropna=False).size(),
    "Removed_Blank_Seg": raw_df[mask_seg].groupby("Region Id", dropna=False).size(),
    "Removed_Part_9xx": raw_df[mask_part9].groupby("Region Id", dropna=False).size(),
    "Removed_Blank_Bulk": raw_df[mask_bulk].groupby("Region Id", dropna=False).size(),
    "Clean_Rows_Remaining": curr_df.groupby("Region Id", dropna=False).size(),
}).fillna(0).astype(int)
diag_by_region["Retention_%"] = (diag_by_region["Clean_Rows_Remaining"] / diag_by_region["Raw_Rows"] * 100).round(2)

display(Markdown("### C. Cleaning Attrition Breakdown by Region Id"))
display(diag_by_region.sort_values("Raw_Rows", ascending=False))

# Plot Waterfall
fig, axes = plt.subplots(1, 2, figsize=(15, 5))
short_labels = ["Raw", "Qty > 0", "Valid Seg", "No '9' Part", "Valid Bulk", "Valid Keys"]

sns.barplot(x=short_labels, y=waterfall_df["Rows_Remaining"], ax=axes[0], palette="Blues_d")
axes[0].set_title("Row Retention Across Cleaning Steps")
axes[0].set_ylabel("Row Count")
axes[0].yaxis.set_major_formatter(mtick.StrMethodFormatter("{x:,.0f}"))
for i, v in enumerate(waterfall_df["Rows_Remaining"]):
    axes[0].text(i, v, f"{v:,.0f}\n({waterfall_df['Retained_Rows_%'].iloc[i]}%)", ha="center", va="bottom", fontsize=9)

sns.barplot(x=short_labels, y=waterfall_df["Qty_Remaining"], ax=axes[1], palette="Greens_d")
axes[1].set_title("Positive Volume (Quantity) Retention Across Cleaning Steps")
axes[1].set_ylabel("Total Quantity")
axes[1].yaxis.set_major_formatter(mtick.StrMethodFormatter("{x:,.0f}"))
for i, v in enumerate(waterfall_df["Qty_Remaining"]):
    axes[1].text(i, v, f"{v:,.0f}\n({waterfall_df['Retained_Qty_%'].iloc[i]}%)", ha="center", va="bottom", fontsize=9)

plt.tight_layout()
plt.show()

# Final clean transactional dataframe
clean_df = curr_df.copy()
clean_df["Year"] = clean_df["Date"].dt.year
clean_df["Month"] = clean_df["Date"].dt.month
clean_df["YearMonth"] = clean_df["Date"].dt.to_period("M")

```

